// Esquema de base de datos — Agenda App
// Professional  = el profesional/pyme que usa la app (dueño de la cuenta)
// Service       = un servicio que ofrece (ej. "Corte de pelo", 30 min)
// Availability  = bloques de disponibilidad semanal recurrente
// DateException = días puntuales bloqueados (feriados, vacaciones)
// Booking       = una reserva concreta hecha por un cliente

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Professional {
  id           String   @id @default(uuid())
  // id del usuario en Supabase Auth (auth.users.id) — vincula login con este perfil
  authUserId   String   @unique
  email        String
  businessName String
  slug         String   @unique
  phone        String?
  // Portal público
  description  String?
  address      String?
  // Color de acento de la marca (hex, ej. #0f766e)
  brandColor   String   @default("#2f4a3e")
  // Política de cancelación: horas mínimas de anticipación para cancelar/reprogramar
  cancellationHours Int @default(24)
  // Zona horaria del negocio (los horarios se interpretan en esta zona)
  timezone     String   @default("America/Santiago")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services       Service[]
  availability   Availability[]
  dateExceptions DateException[]
  bookings       Booking[]
}

model Service {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  durationMin    Int
  price          Int?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  bookings Booking[]

  @@index([professionalId])
}

// Disponibilidad semanal recurrente (ej: lunes 09:00-13:00)
model Availability {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  // 0 = domingo ... 6 = sábado
  weekday        Int
  startMinutes   Int // minutos desde medianoche, ej. 540 = 09:00
  endMinutes     Int

  @@index([professionalId, weekday])
}

// Día puntual sin atención (feriado, vacaciones, emergencia)
model DateException {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  // Fecha del día bloqueado, como "YYYY-MM-DD" para evitar ambigüedad de zona horaria
  date           String
  reason         String?
  createdAt      DateTime     @default(now())

  @@unique([professionalId, date])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Booking {
  id             String        @id @default(uuid())
  professionalId String
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  clientName     String
  clientPhone    String
  clientEmail    String?
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(CONFIRMED)
  // Token del link único de gestión que recibe el cliente (ver /reserva/[token])
  manageToken    String        @unique @default(uuid())
  // Nota interna del profesional sobre el cliente/cita (no visible para el cliente)
  internalNote   String?
  // Motivo de cancelación (visible para el cliente si cancela el profesional)
  cancelReason   String?
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([professionalId, startTime])
}
