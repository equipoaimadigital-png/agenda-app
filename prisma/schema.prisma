// Esquema de base de datos — Tú Agenda
// Professional  = la cuenta/negocio (dueño de la cuenta, login, marca, slug)
// Staff         = un profesional que atiende dentro del negocio (1..N por negocio)
// Service       = un servicio que ofrece el negocio (ej. "Corte de pelo", 30 min)
// Availability  = bloques de disponibilidad semanal recurrente, por Staff
// DateException = días puntuales bloqueados (feriados, vacaciones), por Staff
// Booking       = una reserva concreta hecha por un cliente, con un Staff asignado

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Estado de la suscripción mensual ($12.000 CLP) que el PROFESIONAL paga
// para usar Tú Agenda — no tiene relación con pagos de sus propios clientes.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Professional {
  id           String   @id @default(uuid())
  // id del usuario en Supabase Auth (auth.users.id) — vincula login con este perfil
  authUserId   String   @unique
  email        String
  businessName String
  slug         String   @unique
  phone        String?
  // Portal público
  description  String?
  address      String?
  // URL de una imagen de portada (el profesional la sube a donde quiera y
  // pega el link — no manejamos subida de archivos todavía)
  coverImageUrl String?
  // Color de acento de la marca (hex, ej. #2f4a3e)
  brandColor   String   @default("#2f4a3e")
  // Estilo tipográfico del nombre/descripción en la página pública
  headingFont  HeadingFont @default(FRAUNCES)
  headingSize  HeadingSize @default(MEDIUM)
  // Links de redes sociales, mostrados como botones en la página pública
  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  // El profesional cerró el checklist de "Primeros pasos" del dashboard
  onboardingDismissed Boolean @default(false)
  // Política de cancelación: horas mínimas de anticipación para cancelar/reprogramar
  cancellationHours Int @default(24)
  // Zona horaria del negocio (los horarios se interpretan en esta zona) — la
  // comparte todo el staff del negocio
  timezone     String   @default("America/Santiago")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Suscripción del profesional a Tú Agenda (no confundir con pagos de sus clientes)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  // Fin de la prueba gratis de 14 días, fijado al registrarse
  trialEndsAt        DateTime?
  // ID de la suscripción (Preapproval) en Mercado Pago, una vez autorizada
  mpPreapprovalId    String?

  staff     Staff[]
  services  Service[]
  bookings  Booking[]
  clients   Client[]
  campaigns EmailCampaign[]
}

// Datos persistentes de un cliente que no cambian entre citas (ej. cumpleaños).
// El resto de la info del cliente (nombre, teléfono, email) vive en cada
// Booking — este modelo solo guarda lo que no tiene sentido repetir/editar
// reserva por reserva. Se identifica por teléfono dentro de cada negocio.
model Client {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  phone          String
  // "MM-DD", sin año, para no pedir más datos personales de los necesarios
  birthday       String?
  // Se desuscribió de campañas de email marketing (nunca se le vuelve a
  // mandar una, aunque el negocio elija "todos los clientes")
  unsubscribed      Boolean  @default(false)
  // Token impredecible para el link de desuscripción de un clic, sin login
  unsubscribeToken  String   @unique @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([professionalId, phone])
}

// Un profesional que atiende dentro del negocio (ej. cada estilista de una
// peluquería, cada médico de una clínica). Todo negocio nuevo arranca con un
// Staff por defecto para que el flujo de un solo profesional siga igual.
model Staff {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  // Color para diferenciarlo visualmente en la agenda (hex)
  color          String       @default("#2f4a3e")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  services       Service[]        // muchos a muchos: qué servicios puede realizar
  availability   Availability[]
  dateExceptions DateException[]
  bookings       Booking[]

  @@index([professionalId])
}

model Service {
  id             String           @id @default(uuid())
  professionalId String
  professional   Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  durationMin    Int
  price          Int?
  priceType      ServicePriceType @default(FIXED)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())

  staff    Staff[]        // qué profesionales pueden realizar este servicio
  bookings Booking[]
  fields   ServiceField[] // preguntas personalizadas que el cliente responde al reservar

  @@index([professionalId])
}

// FIXED: precio informativo fijo (ej. corte de pelo). FROM: precio desde X,
// para servicios cuyo costo final varía (ej. consultoría por horas).
// QUOTE: sin precio público, se cotiza en la consulta (ej. estudio jurídico).
enum ServicePriceType {
  FIXED
  FROM
  QUOTE
}

// Combinaciones de tipografía curadas para el nombre/descripción del
// negocio en la página pública — no es un selector libre de fuentes,
// para no romper el sistema de diseño.
enum HeadingFont {
  FRAUNCES // Clásico — serif actual
  PLAYFAIR // Editorial — serif alto, estudios/consultoría
  POPPINS  // Moderno — sans geométrico
  WORK_SANS // Cercano — igual al texto del cuerpo, en negrita
}

enum HeadingSize {
  SMALL
  MEDIUM
  LARGE
}

enum FieldType {
  TEXT
  SELECT
}

// Pregunta personalizada que el profesional agrega a un servicio específico
// (ej. "¿Ya iniciaste el trámite?" en un abogado), respondida por el cliente
// al reservar y guardada en Booking.customAnswers.
model ServiceField {
  id        String    @id @default(uuid())
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  label     String
  type      FieldType @default(TEXT)
  // Opciones para type = SELECT; ignorado si type = TEXT
  options   String[]  @default([])
  required  Boolean   @default(false)
  order     Int       @default(0)

  @@index([serviceId])
}

// Disponibilidad semanal recurrente de un Staff (ej: lunes 09:00-13:00)
model Availability {
  id           String @id @default(uuid())
  staffId      String
  staff        Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // 0 = domingo ... 6 = sábado
  weekday      Int
  startMinutes Int // minutos desde medianoche, ej. 540 = 09:00
  endMinutes   Int

  @@index([staffId, weekday])
}

// Día puntual sin atención de un Staff (feriado, vacaciones, emergencia)
model DateException {
  id      String @id @default(uuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // Fecha del día bloqueado, como "YYYY-MM-DD" para evitar ambigüedad de zona horaria
  date    String
  reason  String?
  createdAt DateTime @default(now())

  @@unique([staffId, date])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// De dónde vino la reserva: el cliente la hizo solo (ONLINE) o el profesional
// la anotó a mano en el panel, ej. por un llamado telefónico (MANUAL).
enum BookingSource {
  ONLINE
  MANUAL
}

model Booking {
  id             String        @id @default(uuid())
  // Se mantiene para scoping simple del dashboard del dueño del negocio
  professionalId String
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  // Quién atiende esta cita específicamente
  staffId        String
  staff          Staff         @relation(fields: [staffId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  clientName     String
  clientPhone    String
  clientEmail    String?
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(CONFIRMED)
  source         BookingSource @default(ONLINE)
  // Token del link único de gestión que recibe el cliente (ver /reserva/[token])
  manageToken    String        @unique @default(uuid())
  // Nota interna del profesional sobre el cliente/cita (no visible para el cliente)
  internalNote   String?
  // Respuestas a las preguntas personalizadas del servicio (ver ServiceField),
  // guardadas como [{ label: string, value: string }] — no se necesita join
  // porque solo se muestran, nunca se filtran ni se agregan.
  customAnswers  Json?
  // Motivo de cancelación (visible para el cliente si cancela el profesional)
  cancelReason   String?
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([staffId, startTime])
  @@index([professionalId, startTime])
}

// A quién se le mandó la campaña: todos los clientes, solo los que no
// reservan hace 30+ días (para reactivarlos), o una selección puntual.
enum CampaignAudience {
  ALL
  INACTIVE_30D
  CUSTOM
}

// Registro de una campaña de email marketing ya enviada. Se guarda después
// de mandarla (no hay borradores) — sirve como historial para el negocio.
model EmailCampaign {
  id             String           @id @default(uuid())
  professionalId String
  professional   Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  subject        String
  body           String
  audience       CampaignAudience
  recipientCount Int
  createdAt      DateTime         @default(now())

  @@index([professionalId, createdAt])
}
