# Copia este archivo como .env.local y rellena los valores reales.
# .env.local NUNCA se sube a git ni se comparte en el chat.

# Supabase → Project Settings → Database → Connection string (modo "Transaction pooler")
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Supabase → Project Settings → Database → Connection string (modo "Session pooler", para migraciones)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# Resend → API Keys
RESEND_API_KEY="re_xxxxx"

# URL pública del sitio (localhost en desarrollo, dominio real en producción)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opcional: protege /api/cron/reminders para que solo Vercel Cron pueda llamarlo
CRON_SECRET=""

# Mercado Pago → Tus integraciones → Credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=""
# Mercado Pago → Tus integraciones → Webhooks → Clave secreta (para verificar firma)
MERCADOPAGO_WEBHOOK_SECRET=""

# Sentry → Settings → Projects → (tu proyecto) → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""

# Twilio → Console → Account → API keys & tokens. Opcional: sin esto, el
# recordatorio por SMS simplemente no se envía (no rompe nada).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Twilio → Console → Phone Numbers → tu número comprado, en formato E.164 (+56...)
TWILIO_PHONE_NUMBER=""
