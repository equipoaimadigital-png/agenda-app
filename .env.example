# Copia este archivo como .env.local y rellena los valores reales.
# .env.local NUNCA se sube a git ni se comparte en el chat.

# Supabase → Project Settings → Database → Connection string (modo "Transaction pooler")
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Supabase → Project Settings → Database → Connection string (modo "Session pooler", para migraciones)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Supabase → Project Settings → API → Project API keys → service_role (secreta,
# ignora RLS). Solo la usa el cron de backup para subir a Storage. NUNCA
# exponerla al cliente ni prefijarla con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Resend → API Keys
RESEND_API_KEY="re_xxxxx"

# URL pública del sitio (localhost en desarrollo, dominio real en producción)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opcional: protege /api/cron/reminders para que solo Vercel Cron pueda llamarlo
CRON_SECRET=""

# Mercado Pago → Tus integraciones → Credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=""
# Mercado Pago → Tus integraciones → Webhooks → Clave secreta (para verificar firma)
MERCADOPAGO_WEBHOOK_SECRET=""

# Id del PLAN de suscripción mensual (el "cobro automático"). Se crea UNA
# vez con:  node --env-file=.env.local prisma/scripts/create-mp-plan.mjs
# y se pega acá el id que imprime. Sin esto, el botón "Activar cobro
# automático" queda deshabilitado (el pago anual funciona igual).
MERCADOPAGO_SUBSCRIPTION_PLAN_ID=""

# Mercado Pago Connect (OAuth) — requiere activar el producto "Marketplace"
# en tu aplicación de Mercado Pago. Son credenciales DISTINTAS al Access
# Token de arriba: ese cobra a nombre de la plataforma (suscripciones);
# estas permiten que cada profesional conecte SU PROPIA cuenta para recibir
# directo los depósitos de sus clientes. Opcional: sin esto, ningún
# profesional puede pedir depósito, pero el resto de la app funciona igual.
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""

# Llave para cifrar en la base los tokens de MP Connect de cada profesional
# (AES-256-GCM). 32 bytes en hex (64 caracteres) o base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esta variable los tokens se guardan SIN cifrar (solo aceptable en dev).
ENCRYPTION_KEY=""

# Sentry → Settings → Projects → (tu proyecto) → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""

# Twilio → Console → Account → API keys & tokens. Opcional: sin esto, el
# recordatorio por SMS simplemente no se envía (no rompe nada).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Twilio → Console → Phone Numbers → tu número comprado, en formato E.164 (+56...)
TWILIO_PHONE_NUMBER=""
# Twilio → Content Template Builder → SID de la plantilla de RECORDATORIO
# aprobada por Meta (4 variables: {{1}} nombre, {{2}} servicio, {{3}} negocio,
# {{4}} cuándo). Opcional: sin esto, el recordatorio va solo por SMS/email.
TWILIO_WHATSAPP_TEMPLATE_SID=""
# SID de la plantilla de CONFIRMACIÓN aprobada por Meta (mismas 4 variables).
# WhatsApp NO permite mensajes libres iniciados por el negocio, así que la
# confirmación por WhatsApp requiere su propia plantilla. Sin esto, la
# confirmación va solo por email + SMS (no se intenta WhatsApp).
TWILIO_WHATSAPP_CONFIRM_TEMPLATE_SID=""
